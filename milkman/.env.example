# Stripe — Dashboard → Developers → API keys → Secret key (sk_live_... for real orders)
STRIPE_SECRET_KEY=

# Flavors default to these Stripe products (checkout uses each product's default price).
# Set only to override with another prod_... or a specific price_... ID.
# STRIPE_PRICE_APPLE_CIDER_BROWN_BUTTER=prod_VgN09I6aGk1lLI
# STRIPE_PRICE_SAGE_CRANBERRY=prod_VgN2ysuOg6wnM1

# Optional overrides
# MILKMAN_DROP_AT=2026-11-24T15:00:00Z
# MILKMAN_SITE_URL=https://milkman.shaynebernier.com

# Twilio — for the 9 am text (not wired yet)
# TWILIO_ACCOUNT_SID=
